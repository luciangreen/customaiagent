    {
      "id": "answer",
      "type": "output",
      "label": "Answer",
      "x": 300,
      "y": 520,
      "width": 140,
      "height": 90,
      "shape": "parallelogram",
      "icon": "⇠",
      "config": {
        "variable": "answer"
      }
